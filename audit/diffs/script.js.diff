   /* ---------- 工具函数 ---------- */
   const $ = (id) => document.getElementById(id);
 
+  /* ================================================================
+   * RequestGate —— 异步请求身份闸门
+   * ----------------------------------------------------------------
+   * 修复缺陷 #4：原来每个请求各自 await 后直接渲染，请求之间没有身份
+   * 概念。用户连续搜索时，先发出的慢响应会后到并覆盖后发请求的结果
+   * （实测：输入框已是"000858 五粮液"，页面渲染的却是"贵州茅台"）。
+   *
+   * 现在按"通道（channel）"维度用 Map 记录最新令牌：发起请求时领取
+   * 自增令牌，响应回来先校验是否仍是最新，过期响应与其错误一并丢弃。
+   * 通道粒度可扩展：hot / feeds / detail / stock 各自独立互不干扰。
+   * ================================================================ */
+  const RequestGate = (function () {
+    const issued = {};   // Map: channel → 最新令牌
+    return {
+      /** 发起请求前领取令牌 */
+      begin(channel) {
+        issued[channel] = (issued[channel] || 0) + 1;
+        return issued[channel];
+      },
+      /** 响应返回时校验：false 表示已被更新的请求取代，应丢弃 */
+      isCurrent(channel, token) {
+        return issued[channel] === token;
+      },
+      /** 主动作废某通道的在途请求（如切换筛选、关闭视图） */
+      invalidate(channel) {
+        issued[channel] = (issued[channel] || 0) + 1;
+      },
+      /** 令牌快照（调试用） */
+      snapshot() {
+        return Object.assign({}, issued);
+      }
+    };
+  })();
+
