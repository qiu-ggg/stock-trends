+/* ================================================================
+ * T7\u3010\u4e25\u91cd\u3011\u5feb\u901f\u8fde\u7eed\u641c\u7d22\u7684\u5f02\u6b65\u7ade\u6001
+ * ================================================================ */
+function T7(done) {
+  console.log('\nT7 \u3010\u4e25\u91cd\u3011\u5feb\u901f\u8fde\u7eed\u641c\u7d22\u7684\u5f02\u6b65\u7ade\u6001');
+  const slow = 300, fast = 30;
+
+  function payloadFor(tc, name, price) {
+    const rows = [];
+    let p = price * 0.8;
+    for (let i = 0; i < 120; i++) {
+      p += 0.05;
+      rows.push(['2026-01-' + String((i % 28) + 1).padStart(2, '0'),
+        p.toFixed(2), (p + 0.06).toFixed(2), (p + 0.2).toFixed(2), (p - 0.2).toFixed(2), String(90000 + i)]);
