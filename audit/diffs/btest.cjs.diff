+/* 缺陷定向测试（.btest.cjs）
+ * 目的：验证代码审查中发现的疑似缺陷，全部为只读测试，不修改任何产品代码。
+ * 运行：node .btest.cjs
+ * 说明：复用项目 .itest.cjs 的 vm 沙箱思路，用桩替换 fetch / localStorage / DOM。
+ */
+const fs = require('fs');
+const vm = require('vm');
+
+let PASS = 0, FAIL = 0;
+function check(name, cond, detail) {
+  if (cond) { PASS++; console.log('  \u2713 ' + name + (detail ? ' \u2014 ' + detail : '')); }
+  else { FAIL++; console.log('  \u2717 ' + name + (detail ? ' \u2014 ' + detail : '')); }
+}
+function info(msg) { console.log('    \u00b7 ' + msg); }
+
+/* ============ 通用桩 ============ */
+function makeStore() { return {}; }
+function makeLocalStorage(store) {
+  return {
+    getItem: (k) => (k in store ? store[k] : null),
+    setItem: (k, v) => { store[k] = String(v); },
+    removeItem: (k) => { delete store[k]; }
+  };
+}
+
+/* 生成 K 线：[{date,open,close,high,low,volume,amount}] */
+function genKline(n, fn) {
+  const out = [];
+  for (let i = 0; i < n; i++) {
+    const c = fn(i);
+    out.push({
+      date: '2026-01-' + String((i % 28) + 1).padStart(2, '0'),
+      open: +(c * 0.995).toFixed(2), close: +c.toFixed(2),
+      high: +(c * 1.012).toFixed(2), low: +(c * 0.985).toFixed(2),
+      volume: 100000 + i * 500, amount: c * 1e6
+    });
+  }
+  return out;
+}
+function makeQuote(price, changePct) {
+  return {
+    open: +(price * 0.99).toFixed(2), prevClose: +(price * 0.98).toFixed(2),
+    high: +(price * 1.02).toFixed(2), low: +(price * 0.97).toFixed(2),
+    volume: 1.2e7, amount: 3.6e8, turnover: 3.4, pe: 31.2, pb: 2.8,
+    amplitude: 4.1, floatCap: 240, totalCap: 300,
+    limitUp: +(price * 1.1).toFixed(2), limitDown: +(price * 0.9).toFixed(2)
+  };
+}
+function makeCtx(code, name, kline, price, changePct) {
+  return {
+    code, name, market: 'sh', price, changePct: changePct,
+    quote: makeQuote(price, changePct), kline: kline, chartBars: Math.min(kline.length, 120)
+  };
+}
+
+/* ============ 沙箱 A：仅数据层（profiles.js + data.js） ============ */
+function makeDataSandbox(store, fetchImpl) {
+  const sb = {
+    console, Date, Math, JSON, Promise, isNaN, isFinite, parseInt, parseFloat,
+    Number, String, Array, Object, Boolean, Error, TypeError, RegExp,
+    encodeURIComponent, decodeURIComponent, AbortController,
+    setTimeout, clearTimeout,
+    localStorage: makeLocalStorage(store),
+    fetch: fetchImpl || function () { return Promise.reject(new Error('network disabled')); }
+  };
+  sb.window = sb; sb.globalThis = sb;
+  vm.createContext(sb);
+  vm.runInContext(fs.readFileSync('profiles.js', 'utf8'), sb, { filename: 'profiles.js' });
+  vm.runInContext(fs.readFileSync('data.js', 'utf8'), sb, { filename: 'data.js' });
+  return sb;
+}
+
+/* ============ 沙箱 B：完整前端（含 DOM 桩，用于竞态测试） ============ */
+function makeAppSandbox(store, fetchImpl) {
+  const handlers = {}, elements = {};
+  function makeEl(id) {
+    return {
+      id: id || '', innerHTML: '', textContent: '', value: '', disabled: false,
+      dataset: {}, style: {}, hidden: false, className: '',
+      classList: {
+        _s: {}, add(c) { this._s[c] = true; }, remove(c) { this._s[c] = false; },
+        toggle(c, f) { const v = f === undefined ? !this._s[c] : !!f; this._s[c] = v; return v; },
+        contains(c) { return !!this._s[c]; }
+      },
+      addEventListener(ev, fn) { (handlers[id + ':' + ev] = handlers[id + ':' + ev] || []).push(fn); },
+      querySelector() { return null; }, querySelectorAll() { return []; },
+      appendChild() {}, removeChild() {}, remove() {}, focus() {},
+      setAttribute() {}, getAttribute() { return null; }, matches() { return false; },
+      closest() { return null; }, click() {}
+    };
+  }
+  function getEl(id) { if (!elements[id]) elements[id] = makeEl(id); return elements[id]; }
+  const document = {
+    getElementById: getEl,
+    querySelectorAll() { return []; }, querySelector() { return null; },
+    createElement(tag) { const e = makeEl('created-' + tag); e.tagName = tag; return e; },
+    body: makeEl('body'), addEventListener() {}
+  };
+  const sb = {
+    console, Date, Math, JSON, Promise, isNaN, isFinite, parseInt, parseFloat,
+    Number, String, Array, Object, Boolean, Error, TypeError, RegExp,
+    encodeURIComponent, decodeURIComponent, AbortController,
+    setTimeout, clearTimeout, setInterval, clearInterval,
+    requestAnimationFrame: (fn) => setTimeout(fn, 0),
+    document, localStorage: makeLocalStorage(store),
+    scrollTo() {}, devicePixelRatio: 2, addEventListener() {},
+    echarts: { init: () => ({ setOption() {}, resize() {} }) },
+    Blob: function (parts) { this.parts = parts; },
+    URL: { createObjectURL: () => 'blob:x', revokeObjectURL() {} },
+    fetch: fetchImpl
+  };
+  sb.window = sb; sb.globalThis = sb;
+  vm.createContext(sb);
+  vm.runInContext(fs.readFileSync('profiles.js', 'utf8'), sb, { filename: 'profiles.js' });
+  vm.runInContext(fs.readFileSync('data.js', 'utf8'), sb, { filename: 'data.js' });
+  vm.runInContext(fs.readFileSync('script.js', 'utf8'), sb, { filename: 'script.js' });
+  return { sb, handlers, getEl };
+}
+
+/* ================================================================
+ * T1【致命】自动画像的风控价位是"随动值"还是"固定位"
+ * 背景：deriveLevels 以现价为锚（P - n×ATR），因此 auto 画像下
+ *       decideAction 的 belowHard/belowStop/aboveT1/aboveT2 四个风控
+ *       分支在数学上不可能触发（data.js:1651 又把 L 置空）。
+ *       但报告/计划卡片仍把它当成确定性价位展示给用户。
+ * ================================================================ */
+function T1() {
+  console.log('\nT1 \u3010\u81f4\u547d\u3011\u81ea\u52a8\u753b\u50cf\u98ce\u63a7\u4ef7\u4f4d\u662f\u5426\u53ef\u6267\u884c');
+  const sb = makeDataSandbox(makeStore());
+
+  // 1a) 价位来源与静态性是否随计划一同输出（判定层与展示层同源的结构契约）
+  const rows = [20, 40, 80].map((base) => {
+    const k = genKline(70, (i) => base + i * (base * 0.012));
+    const price = k[k.length - 1].close;
+    const r = sb.STOCK_DATA.analyzeEnhance(makeCtx('600000', '测试股', k, price, 1));
+    const p = r.plan || {};
+    return {
+      price: r.ind && r.ind.price, stopLoss: p.stopLoss, hardStop: p.hardStop,
+      levelsSource: p.levelsSource, levelsStatic: p.levelsStatic,
+      levelsNote: p.levelsNote, anchorNote: p.anchorNote
+    };
+  });
+  rows.forEach((l) => info('止损 ' + l.stopLoss + ' / 硬止损 ' + l.hardStop + ' | source=' + l.levelsSource + ' | static=' + l.levelsStatic));
+  check('计划输出携带价位来源与静态性（判定与展示同源）',
+    rows.every((l) => l.levelsSource === 'derived' && typeof l.levelsStatic === 'boolean'),
+    JSON.stringify(rows.map((l) => l.levelsSource + '/' + l.levelsStatic)));
+  check('随动推导的止损位必须附带披露文案',
+    rows.every((l) => l.levelsStatic === true || /随|参考|移动/.test(String(l.levelsNote))),
+    'levelsNote="' + String(rows[0].levelsNote).slice(0, 90) + '"');
+
+  // 1a-2) 锚定路径可用性：扫描多种形态，确认存在成功锚定绝对支撑的样本
+  let anchored = 0, scanned = 0;
+  for (let amp of [0.05, 0.1, 0.2, 0.4]) {
+    for (let rise of [0.002, 0.005, 0.01, 0.02]) {
+      const k = genKline(80, (i) => 30 + Math.sin(i / 4) * amp + i * rise);
+      const price = k[k.length - 1].close;
+      const r = sb.STOCK_DATA.analyzeEnhance(makeCtx('600000', '测试股', k, price, 0.5));
+      scanned++;
+      if (r && r.plan && r.plan.levelsStatic) anchored++;
+    }
+  }
+  info('锚定扫描：' + anchored + ' / ' + scanned + ' 组样本成功锚定到绝对支撑位');
+  check('存在可锚定绝对支撑的样本（锚定策略路径可用）', anchored > 0, anchored + ' / ' + scanned);
+
+  // 1b) 有研报画像、但现价远离计划入场区间时，盈亏比是否仍照常展示
+  const k2 = genKline(70, (i) => 10 + i * 0.5);
+  const price2 = k2[k2.length - 1].close;
+  const r2 = sb.STOCK_DATA.analyzeEnhance(makeCtx('000063', '中兴通讯', k2, price2, 8.5));
+  const p2 = r2.plan || {};
+  const lo = p2.entry ? Math.min(p2.entry[0], p2.entry[1]) : null;
+  const hi = p2.entry ? Math.max(p2.entry[0], p2.entry[1]) : null;
+  const inZone = lo != null && price2 >= lo && price2 <= hi;
+  info('000063 现价 ' + price2 + '，计划入场区间 [' + lo + ', ' + hi + ']，是否在区间内 ' + inZone + '，盈亏比 ' + p2.riskReward);
+  info('rrNote：' + String(p2.rrNote).slice(0, 110));
+  check('现价已明显离开计划入场区间时，盈亏比须标注不可执行',
+    inZone || p2.riskReward == null || /不在区间|已离开|现价已高于|不适用/.test(String(p2.rrNote)),
+    'riskReward=' + p2.riskReward + '（修复前为 1.4:1，基于入场价 ' + p2.refEntry + ' 而非现价 ' + price2 + '）');
+}
+
+/* ================================================================
+ * T2【致命】数据抓取失败导致热度基线被清空，后续 delta 变为虚构值
+ * ================================================================ */
+function T2() {
+  console.log('\nT2 \u3010\u81f4\u547d\u3011\u7f51\u7edc\u5931\u8d25\u540e\u70ed\u5ea6\u57fa\u7ebf\u662f\u5426\u88ab\u6e05\u7a7a');
+  const store = makeStore();
+  const sb = makeDataSandbox(store);
+  const pool = [
+    { title: '贵州茅台今日大涨 突破前高', content: '利好 买入', heat: 900, platform: 'guba' },
+    { title: '宁德时代订单饱满', content: '看多', heat: 800, platform: 'guba' }
+  ];
+
+  sb.STOCK_DATA.computeHotItems(pool);
+  const baselineKeys = Object.keys(JSON.parse(store['stock-last-hot'] || '{}'));
+  info('第 1 次（正常）：基线已存 ' + baselineKeys.length + ' 个关键词');
+
+  sb.STOCK_DATA.computeHotItems([]);                    // 模拟抓取全部失败 → 空池
+  const afterEmpty = JSON.parse(store['stock-last-hot'] || '{}');
+  info('第 2 次（抓取失败、空池）：基线还剩 ' + Object.keys(afterEmpty).length + ' 个关键词');
+
+  check('抓取失败（空池）时不应覆盖已有热度基线',
+    Object.keys(afterEmpty).length > 0,
+    '当前基线保留 ' + Object.keys(afterEmpty).length + ' 个关键词（修复前会被清空为 {}）');
+
+  const items = sb.STOCK_DATA.computeHotItems(pool);     // 恢复后再算
+  const first = items[0] || {};
+  info('第 3 次（恢复）：首位 delta=' + JSON.stringify(first.delta) + ', deltaLabel=' + JSON.stringify(first.deltaLabel) + ', source=' + first.deltaSource);
+  check('空池后基线仍在，恢复抓取时按真实基线计算变化率',
+    first.deltaSource === 'baseline' && first.delta !== null,
+    'delta=' + JSON.stringify(first.delta) + ', source=' + first.deltaSource);
+
+  // 3b) 全新环境（无任何历史基线）下的契约：给出来源语义而非伪造数值
+  const sbFresh = makeDataSandbox(makeStore());
+  const fresh = sbFresh.STOCK_DATA.computeHotItems(pool)[0] || {};
+  info('全新环境：delta=' + JSON.stringify(fresh.delta) + ', deltaLabel=' + JSON.stringify(fresh.deltaLabel) + ', source=' + fresh.deltaSource);
+  check('无历史基线时 delta 为 null 并标注来源（不再用哈希伪造数值）',
+    fresh.delta === null && fresh.deltaSource === 'firstSeen' && !!fresh.deltaLabel,
+    'delta=' + JSON.stringify(fresh.delta) + ', source=' + fresh.deltaSource + ', label=' + JSON.stringify(fresh.deltaLabel));
+}
+
+/* ================================================================
+ * T3【严重】RSI 分支存在 45\u201355 死区，静默丢失信号
+ * ================================================================ */
+function T3() {
+  console.log('\nT3 \u3010\u4e25\u91cd\u3011RSI \u5206\u652f 45\u201355 \u6b7b\u533a');
+  const sb = makeDataSandbox(makeStore());
+  // 扫描参数空间，明确找出 RSI 落在 45\u201355 的样本（否则断言会假通过）
+  let hit = null, scanned = 0;
+  for (let amp = 0.1; amp <= 2.5 && !hit; amp += 0.05) {
+    for (let slope = -0.08; slope <= 0.08 && !hit; slope += 0.004) {
+      const k = genKline(80, (i) => 30 + i * slope + Math.sin(i / 3) * amp);
+      const price = k[k.length - 1].close;
+      const r = sb.STOCK_DATA.analyzeEnhance(makeCtx('600000', '测试股', k, price, 0));
+      scanned++;
+      if (r.error || !r.ind || r.ind.rsi == null) continue;
+      if (r.ind.rsi > 45 && r.ind.rsi < 55) {
+        hit = {
+          rsi: r.ind.rsi, amp: +amp.toFixed(2), slope: +slope.toFixed(3),
+          sigs: (r.signals.all || []).filter((s) => String(s.id).indexOf('rsi') === 0)
+        };
+      }
+    }
+  }
+  if (!hit) {
+    info('扫描 ' + scanned + ' 组参数未构造出 RSI\u2208(45,55) 的样本，本项无法判定');
+    check('RSI 45\u201355 死区可验证性', false, '未取到样本');
+    return;
+  }
+  info('找到样本：RSI=' + hit.rsi + '（amp=' + hit.amp + ', slope=' + hit.slope + '），扫描 ' + scanned + ' 组');
+  info('该样本产生的 RSI 维度信号数：' + hit.sigs.length);
+  check('RSI 落在 45\u201355（非超买非超卖区）时应输出一条中性信号',
+    hit.sigs.length > 0,
+    '信号数 ' + hit.sigs.length + '（修复前恒为 0：条件链 >=75 / <=28 / >=55 / <=45 在 45<RSI<55 处是空档）');
+}
+
+/* ================================================================
+ * T4【中】关键词模糊匹配越界命中
+ * ================================================================ */
+function T4() {
+  console.log('\nT4 \u3010\u4e25\u91cd\u3011\u80a1\u7968\u5173\u952e\u8bcd\u6a21\u7cca\u5339\u914d');
